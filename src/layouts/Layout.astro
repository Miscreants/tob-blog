---
// Document shell: <head>, SEO, fonts, theme bootstrap. Page chrome (top bar,
// directory tree, rails) lives in BlogShell, which wraps this.
import "../styles/global.css";
import geistUrl from "../assets/fonts/Geist-Variable.woff2?url";
import geistMonoUrl from "../assets/fonts/GeistMono-Variable.woff2?url";
import lecturisUrl from "../assets/fonts/FHLecturis-Regular.woff2?url";
import Seo from "../components/Seo.astro";

interface Props {
  title?: string;
  /** Meta description for SEO + social cards. */
  description?: string;
  /** Social share image (root-relative or absolute). */
  image?: string;
  /** og:type — "article" for posts. */
  ogType?: "website" | "article";
  /** Ask crawlers not to index this page. */
  noindex?: boolean;
  /** JSON-LD structured data graph(s). See src/lib/schema.ts. */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /** Server-rendered theme; the inline script replaces it before paint. */
  theme?: "light" | "dark" | "brand";
  /** Frontmatter object, present when this layout is used from a Markdown/MDX page. */
  frontmatter?: { title?: string; theme?: "light" | "dark" | "brand"; description?: string };
}

const fm = Astro.props.frontmatter ?? {};
const {
  title = fm.title ?? "The Trail of Bits Blog",
  description = fm.description,
  image,
  ogType,
  noindex,
  jsonLd,
  theme = fm.theme ?? "light",
} = Astro.props;
const gtagId = import.meta.env.PUBLIC_GTAG_ID;
---

<html lang="en" data-theme={theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <!-- Saved choice wins, else the OS preference. Blocking on purpose: it
         must set data-theme before the first paint or dark visitors flash white. -->
    <script is:inline>
      (() => {
        let saved = null;
        try {
          saved = localStorage.getItem("theme");
        } catch {}
        const theme =
          saved === "light" || saved === "dark"
            ? saved
            : matchMedia("(prefers-color-scheme: dark)").matches
              ? "dark"
              : "light";
        document.documentElement.dataset.theme = theme;
      })();
    </script>
    <link rel="preload" href={geistUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={geistMonoUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={lecturisUrl} as="font" type="font/woff2" crossorigin />
    <link rel="alternate" type="application/rss+xml" title="The Trail of Bits Blog" href="/rss.xml" />
    <Seo title={title} description={description} ogType={ogType} image={image} noindex={noindex} jsonLd={jsonLd} />

    {gtagId && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${gtagId}`}></script>
        <script define:vars={{ gtagId }}>
          window.dataLayer = window.dataLayer || [];
          function gtag(){ dataLayer.push(arguments); }
          gtag('js', new Date());
          gtag('config', gtagId);
        </script>
      </>
    )}
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:px-4 focus:py-2 focus:bg-intent focus:text-fg-on-intent"
    >
      Skip to main content
    </a>
    <slot />
  </body>
</html>
