---
// Custom 404, inside the blog shell so the tree and search stay reachable.
import BlogShell from "../layouts/BlogShell.astro";
import ListingHeader from "../components/ListingHeader.astro";
import Button from "../components/Button.astro";
---

<BlogShell title="Not found — The Trail of Bits Blog" noindex>
  <ListingHeader meta={["404"]} title="No such file or directory" lede="The post or folder you asked for isn't in the tree. It may have moved — try the directory or search." />
  <div class="px-6 pb-16 md:px-8">
    <Button href="/" label="cd ~/blog" withArrow={false} />
  </div>
</BlogShell>
