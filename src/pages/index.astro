---
import BlogShell from "../layouts/BlogShell.astro";
import ListingView from "../components/ListingView.astro";
import { getPosts, paginate, summarize } from "../lib/blog";
import { site } from "../data/site";

// ~/blog — the blog home (Figma "Directory A · Blog Home").
const posts = await getPosts();
const { items, total } = paginate(posts, 1);
---

<BlogShell title={site.name} description={site.description} preview>
  <ListingView
    meta={["index"]}
    title="The Trail of Bits Blog"
    lede={site.description}
    featured={posts.filter((p) => p.data.featured)}
    posts={items.map(summarize(posts))}
    page={1}
    totalPages={total}
    total={posts.length}
  />
</BlogShell>
