---
interface Props {
  class?: string;
}
const { class: className } = Astro.props;

// ⌘K search over posts, folders and authors. A native modal <dialog> (focus
// trap, Esc and inert background for free) that fetches /search.json on first
// open, so no page carries the index in its HTML. Matching is a plain
// all-terms substring test — swap in Pagefind once the archive is imported.
---

<dialog
  data-search
  aria-labelledby="search-title"
  class:list={[
    "bg-canvas text-fg border-stroke-strong shadow-popover backdrop:bg-canvas/70 m-auto mt-[12vh] w-[min(40rem,calc(100vw-2rem))] border p-0",
    className,
  ]}
>
  <h2 id="search-title" class="sr-only">Search the blog</h2>
  <div class="border-stroke flex items-center gap-2 border-b px-4">
    <span class="text-mono-sm text-intent" aria-hidden="true">~/</span>
    <input
      type="search"
      data-search-input
      placeholder="Search posts, folders and authors"
      aria-label="Search posts, folders and authors"
      aria-controls="search-results"
      autocomplete="off"
      spellcheck="false"
      class="placeholder:text-fg-subtle [&::-webkit-search-cancel-button]:appearance-none h-12 min-w-0 flex-1 bg-transparent text-[0.9375rem] outline-none"
    />
    <kbd class="border-stroke-strong text-fg-muted border px-1.5 py-0.5 font-mono text-[0.6875rem] leading-none">esc</kbd>
  </div>
  <ul id="search-results" data-search-results class="max-h-[60vh] overflow-y-auto empty:hidden"></ul>
  <p data-search-status role="status" class="text-mono-sm text-fg-subtle px-4 py-3">Type to search.</p>
</dialog>

<script>
  type Entry = { kind: "post" | "folder" | "author"; title: string; href: string; meta: string; text: string };

  const dialog = document.querySelector<HTMLDialogElement>("[data-search]");
  const input = dialog?.querySelector<HTMLInputElement>("[data-search-input]");
  const list = dialog?.querySelector<HTMLUListElement>("[data-search-results]");
  const status = dialog?.querySelector<HTMLElement>("[data-search-status]");

  if (dialog && input && list && status && !dialog.dataset.ready) {
    dialog.dataset.ready = "true";
    let index: Entry[] | null = null;

    const load = async () => {
      if (index) return index;
      const res = await fetch("/search.json");
      index = (await res.json()) as Entry[];
      return index;
    };

    const render = (entries: Entry[], query: string) => {
      list.replaceChildren(
        ...entries.slice(0, 30).map((e) => {
          const li = document.createElement("li");
          const a = document.createElement("a");
          a.href = e.href;
          a.className =
            "border-stroke hover:bg-panel focus-visible:bg-panel grid grid-cols-[4.5rem_minmax(0,1fr)] gap-x-4 border-b px-4 py-3 outline-none focus-visible:-outline-offset-2";
          const kind = document.createElement("span");
          kind.className = "text-mono-sm text-intent";
          kind.textContent = e.kind;
          const body = document.createElement("span");
          body.className = "flex min-w-0 flex-col gap-0.5";
          const title = document.createElement("span");
          title.className = "h5 truncate";
          title.textContent = e.title;
          const meta = document.createElement("span");
          meta.className = "text-mono-sm text-fg-muted truncate";
          meta.textContent = e.meta;
          body.append(title, meta);
          a.append(kind, body);
          li.append(a);
          return li;
        }),
      );
      status.textContent = !query
        ? "Type to search."
        : entries.length
          ? `${entries.length} result${entries.length === 1 ? "" : "s"}`
          : "No matches.";
    };

    const search = async () => {
      const query = input.value.trim().toLowerCase();
      if (!query) return render([], "");
      const terms = query.split(/\s+/);
      const entries = (await load()).filter((e) => terms.every((t) => e.text.includes(t)));
      render(entries, query);
    };

    const open = () => {
      if (dialog.open) return;
      dialog.showModal();
      input.select();
      load();
    };

    input.addEventListener("input", search);
    // Arrow keys walk input → results without leaving the keyboard row.
    dialog.addEventListener("keydown", (e) => {
      if (e.key !== "ArrowDown" && e.key !== "ArrowUp") return;
      const links = [...list.querySelectorAll<HTMLAnchorElement>("a")];
      if (!links.length) return;
      e.preventDefault();
      const i = links.indexOf(document.activeElement as HTMLAnchorElement);
      if (e.key === "ArrowDown") links[Math.min(i + 1, links.length - 1)].focus();
      else if (i <= 0) input.focus();
      else links[i - 1].focus();
    });
    // Click on the backdrop closes.
    dialog.addEventListener("click", (e) => {
      if (e.target === dialog) dialog.close();
    });

    document.querySelectorAll("[data-search-open]").forEach((btn) => btn.addEventListener("click", open));
    document.addEventListener("keydown", (e) => {
      const typing = (e.target as HTMLElement).closest("input, textarea, [contenteditable]");
      if ((e.key === "k" && (e.metaKey || e.ctrlKey)) || (e.key === "/" && !typing)) {
        e.preventDefault();
        open();
      }
    });
  }
</script>
