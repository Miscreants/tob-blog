---
import PathCrumbs from "./PathCrumbs.astro";
import PathChip from "./PathChip.astro";
import { authorHref, fileName, isoDate, type Post } from "../lib/blog";

interface Props {
  post: Post;
  class?: string;
}
const { post, class: className } = Astro.props;
const { title, description, type, location, alsoIn, authors, date } = post.data;

// Article head: file-path breadcrumb, Lecturis title, standfirst, and the
// TYPE / AUTHOR / PUBLISHED / LOCATION / ALSO IN strip between two rules.
---

<header class:list={["flex flex-col", className]}>
  <PathCrumbs path={location} file={fileName(post)} />
  <h1 class="h1 text-fg mt-7">{title}</h1>
  <p class="text-body-xl text-fg-muted mt-6">{description}</p>

  <dl class="border-stroke-strong mt-9 flex flex-wrap gap-x-10 gap-y-4 border-y py-4">
    <div class="flex flex-col gap-1.5">
      <dt class="text-label text-fg-subtle">Type</dt>
      <dd><span class="type-chip" data-type={type}>{type}</span></dd>
    </div>
    <div class="flex flex-col gap-1.5">
      <dt class="text-label text-fg-subtle">{authors.length > 1 ? "Authors" : "Author"}</dt>
      <dd class="text-mono-md text-fg">
        {
          authors.map((a, i) => (
            <>
              {i > 0 && ", "}
              <a href={authorHref(a)} class="hover:text-intent">
                {a}
              </a>
            </>
          ))
        }
      </dd>
    </div>
    <div class="flex flex-col gap-1.5">
      <dt class="text-label text-fg-subtle">Published</dt>
      <dd class="text-mono-md text-fg"><time datetime={isoDate(date)}>{isoDate(date)}</time></dd>
    </div>
    <div class="flex flex-col gap-1.5">
      <dt class="text-label text-fg-subtle">Location</dt>
      <dd class="text-mono-md text-fg">
        <a href={`/${location}/`} class="hover:text-intent">/{location}</a>
      </dd>
    </div>
    {
      alsoIn.length > 0 && (
        <div class="flex flex-col gap-1.5">
          <dt class="text-label text-fg-subtle">Also in</dt>
          <dd>
            <ul class="flex flex-wrap gap-1.5">
              {alsoIn.map((p) => (
                <li>
                  <PathChip path={p} />
                </li>
              ))}
            </ul>
          </dd>
        </div>
      )
    }
  </dl>
</header>
