---
// One row of DirectoryTree plus its visible children, rendered recursively so
// the markup stays a real nested list for assistive tech. Guide cells come
// precomputed from DirectoryTree.

type Seg = { on: boolean };
type Cell =
  | { kind: "rail"; top: Seg; bottom: Seg }
  | { kind: "tee" | "elbow"; top: Seg; branch: Seg; bottom: Seg }
  | { kind: "fork"; left: Seg; down: Seg }
  | { kind: "dash"; on: boolean }
  | { kind: "dot" }
  | { kind: "blank" };

export interface TreeRow {
  key: string;
  label: string;
  kind: "root" | "group" | "folder";
  href?: string;
  count?: number;
  index?: boolean;
  selected: boolean;
  onPath: boolean;
  current?: "page" | "location";
  /** A folder off the selected path: it starts shut. */
  closed: boolean;
  cells: Cell[];
  children: TreeRow[];
}

interface Props {
  row: TreeRow;
}
const { row } = Astro.props;

const seg = (on: boolean) => (on ? "bg-intent" : "bg-stroke-strong");
// The last cell is the row's own: a dash for leaves, a fork for parents. A
// folder's or group's fork is also its open/shut button; a group's label
// toggles too, and is the keyboard control (its fork is a mouse-only twin).
const lead = row.cells.slice(0, -1);
const own = row.cells[row.cells.length - 1];
const toggleable = row.kind !== "root" && row.children.length > 0;
const subtreeId = `tree-${row.key.replaceAll("/", "--").replace(":", "-")}`;
---

<li
  data-tree-row={row.kind}
  data-folder={toggleable ? row.key : undefined}
  data-state={toggleable ? (row.closed ? "shut" : "open") : undefined}
  data-on-path={toggleable && row.onPath ? "" : undefined}
  class="tree-row"
>
  <div
    class:list={[
      "flex h-[1.625rem] items-center pr-5",
      row.selected ? "bg-panel-muted border-intent border-l-2 pl-3.5" : "pl-4",
    ]}
  >
    <span class="flex shrink-0" aria-hidden="true">
      {
        lead.map((c) => (
          <span class="relative h-[1.625rem] w-4" data-guide={c.kind}>
            {c.kind === "rail" && (
              <>
                <span class:list={["absolute top-0 left-2 h-[0.875rem] w-px", seg(c.top.on)]} />
                <span class:list={["absolute top-[0.8125rem] left-2 h-[0.8125rem] w-px", seg(c.bottom.on)]} />
              </>
            )}
            {(c.kind === "tee" || c.kind === "elbow") && (
              <>
                <span class:list={["absolute top-0 left-2 h-[0.875rem] w-px", seg(c.top.on)]} />
                <span class:list={["absolute top-[0.8125rem] left-2 h-px w-2", seg(c.branch.on)]} />
                {c.kind === "tee" && (
                  <span class:list={["absolute top-[0.8125rem] left-2 h-[0.8125rem] w-px", seg(c.bottom.on)]} />
                )}
              </>
            )}
            {c.kind === "dot" && <span class="bg-fg-subtle absolute top-3 left-[0.4375rem] size-[3px]" />}
          </span>
        ))
      }
      {
        own.kind === "dash" && (
          <span class="relative h-[1.625rem] w-4" data-guide="dash">
            <span class:list={["absolute top-[0.8125rem] left-0 h-px w-3", seg(own.on)]} />
          </span>
        )
      }
      {
        own.kind === "fork" && !toggleable && (
          <span class="relative h-[1.625rem] w-4" data-guide="fork">
            <span class:list={["absolute top-[0.8125rem] left-0 h-px w-[0.5625rem]", seg(own.left.on)]} />
            <span class:list={["absolute top-[0.8125rem] left-2 h-[0.8125rem] w-px", seg(own.down.on)]} />
          </span>
        )
      }
    </span>
    {
      own.kind === "fork" && toggleable && (
        <button
          type="button"
          data-folder-toggle
          aria-expanded={row.closed ? "false" : "true"}
          aria-controls={subtreeId}
          aria-label={`${row.label} subfolders`}
          tabindex={row.kind === "group" ? -1 : undefined}
          aria-hidden={row.kind === "group" ? "true" : undefined}
          class="hover:bg-stroke relative h-[1.625rem] w-4 shrink-0 cursor-pointer transition-colors"
        >
          <span aria-hidden="true">
            <span data-fork-shut class:list={["absolute top-[0.8125rem] left-0 h-px w-3", seg(own.left.on)]} />
            <span data-fork-open>
              <span class:list={["absolute top-[0.8125rem] left-0 h-px w-[0.5625rem]", seg(own.left.on)]} />
              <span class:list={["absolute top-[0.8125rem] left-2 h-[0.8125rem] w-px", seg(own.down.on)]} />
            </span>
          </span>
        </button>
      )
    }
    <span class="w-1.5 shrink-0" aria-hidden="true"></span>
    {
      row.kind === "group" ? (
        <button
          type="button"
          data-folder-toggle
          aria-expanded={row.closed ? "false" : "true"}
          aria-controls={subtreeId}
          class="text-label text-fg-subtle hover:text-fg flex-1 cursor-pointer truncate text-left transition-colors"
        >
          {row.label}
        </button>
      ) : (
        <a
          href={row.href}
          aria-current={row.current}
          class:list={[
            // relative: clips the sr-only count, which otherwise overflows the tree.
            "text-mono-md relative min-w-0 flex-1 truncate leading-4 transition-colors",
            row.selected ? "text-intent font-medium" : row.onPath ? "text-fg" : "text-fg-muted hover:text-fg",
          ]}
        >
          {row.label}{row.index && <span class="text-fg-subtle" aria-hidden="true">@</span>}
          {row.count !== undefined && <span class="sr-only">, {row.count} posts</span>}
        </a>
      )
    }
    {
      row.count !== undefined && (
        <span
          aria-hidden="true"
          class:list={["text-mono-xs shrink-0 tabular-nums", row.selected ? "text-intent" : "text-fg-subtle"]}
        >
          {row.count}
        </span>
      )
    }
  </div>
  {
    row.children.length > 0 && (
      <ul id={toggleable ? subtreeId : undefined}>
        {row.children.map((child) => (
          <Astro.self row={child} />
        ))}
      </ul>
    )
  }
</li>

<style is:global>
  /* Each folder opens and shuts on its own; DirectoryTree's scripts set
     data-state ("expand all" / "collapse all" set every folder at once). */
  [data-state="shut"] > ul,
  [data-state="shut"] > div [data-fork-open],
  [data-state="open"] > div [data-fork-shut] {
    display: none;
  }
</style>
