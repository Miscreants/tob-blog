---
import ListingHeader from "./ListingHeader.astro";
import FeaturedPosts from "./FeaturedPosts.astro";
import PostListing, { type DirRow } from "./PostListing.astro";
import SubscribeForm from "./SubscribeForm.astro";
import type { Post, PostSummary } from "../lib/blog";

interface Props {
  path?: string;
  author?: string;
  meta?: string[];
  title: string;
  lede?: string;
  featured?: Post[];
  posts: PostSummary[];
  dirs?: DirRow[];
  page: number;
  totalPages: number;
  /** Posts in this listing across every page. */
  total: number;
  /** Posts per type across every page, for the type tabs. */
  typeCounts: Record<string, number>;
}
const { path, author, meta, title, lede, featured = [], posts, dirs, page, totalPages, total, typeCounts } = Astro.props;

// Everything a listing page renders inside the shell — blog home, folder,
// author — in the board's order. Routes only resolve data and pass it here.
---

<ListingHeader path={path} meta={meta} title={title} lede={lede} />
{page === 1 && featured.length > 0 && <FeaturedPosts posts={featured} />}
<PostListing posts={posts} dirs={dirs} path={path} author={author} page={page} totalPages={totalPages} total={total} typeCounts={typeCounts} />
<SubscribeForm id="subscribe" />
