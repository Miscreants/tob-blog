{
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
  "version": "0.2",
  "language": "en-US",
  "//": "Advisory spell report — whole repo, every page and doc — see docs/rules/content.md [content.copy]. en-US is the priority spelling: en-GB forms are flagged deliberately and fixed in the copy, never added to `words`. `words` is for terms no locale knows — product, client and industry vocabulary.",
  "dictionaries": [
    "typescript",
    "node",
    "npm",
    "html",
    "css",
    "softwareTerms",
    "filetypes",
    "fonts",
    "companies"
  ],
  "ignorePaths": [
    "node_modules/**",
    "dist/**",
    ".astro/**",
    ".wrangler/**",
    "package-lock.json",
    "public/**",
    "src/env.d.ts"
  ],
  "ignoreRegExpList": [
    "/^import\\s.+$/gm",
    "/^\\s*(from|export \\* from)\\s+[\"'].+[\"']/gm",
    "/\\b(class|className|href|src|srcset|id|name|slot|is|set:html|transition:name)=[\"'][^\"']*[\"']/g",
    "/data-[\\w-]+=[\"'][^\"']*[\"']/g",
    "/(https?:)?\\/\\/[^\\s\"'`)]+/g",
    "/#[0-9a-fA-F]{3,8}\\b/g",
    "/\\b[\\w.-]+@[\\w.-]+\\.\\w+\\b/g",
    "/`[^`]*\\$\\{[^`]*`/g"
  ],
  "words": [
    "affordances",
    "applebot",
    "appsec",
    "archivo",
    "astro",
    "astrojs",
    "Bansal",
    "bento",
