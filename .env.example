# .env.example — copy to .env and fill in values
#
#   cp .env.example .env
#
# Variables with PUBLIC_ prefix are available in the browser.
# Variables without it are server-only (frontmatter, API routes).

# Google Analytics (optional — omit to disable tracking)
PUBLIC_GTAG_ID=

# HubSpot forms (optional — omit to use component defaults)
# PUBLIC_HUBSPOT_PORTAL_ID=
# PUBLIC_HUBSPOT_FORM_ID=

# ── Contact form endpoint (functions/api/contact.ts) ────────────────────────
# Set these in the HOST's environment, not here — they are read at runtime by
# the Pages Function, not at build time. Listed so the keys are discoverable.
#
# ALLOWED_ORIGIN   production origin; submissions from anywhere else are 403'd
# NOTIFY_TO        where submissions are delivered
# FROM_EMAIL       verified sender address
# FROM_NAME        sender display name
#
# Plus a `send_email` binding named NOTIFY_EMAIL. Without the binding the
# endpoint accepts and validates submissions but sends nothing.
